{
  "name": "tech-dashboard",
  "version": "1.0.0",
  "description": "Personal dashboard that pulls tech news, AI paper summaries, and device reviews from RSS/APIs into static JSON files.",
  "type": "module",
  "scripts": {
    "fetch:news": "node scripts/fetch-news.js",
    "fetch:papers": "node scripts/fetch-papers.js",
    "fetch:reviews": "node scripts/fetch-reviews.js",
    "fetch:reddit": "node scripts/fetch-reddit.js",
    "summarize": "node scripts/summarize.js",
    "digest": "node scripts/generate-digest.js",
    "fetch:all": "node scripts/fetch-all.js",
    "test": "node --test",
    "test:browser": "node --test test/browser.test.js",
    "serve": "npx http-server public -p 8080 -o"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "rss-parser": "^3.13.0",
    "xml2js": "^0.6.2"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^26.1.0",
    "wrangler": "^4.142.0"
  }
}
